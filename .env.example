# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file documents the
# SHAPE of the configuration; the real values stay on your machine.
# Compose reads .env automatically and substitutes these into
# docker-compose.yml.

# --- PostgreSQL --------------------------------------------------------------
# Read only on the database's FIRST boot, when the data directory is empty.
# Changing them later has no effect until the volume is removed
# (`docker compose down -v`), because the database already exists.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=restaurant_intelligence

# The database pytest uses, and the only one it is allowed to touch.
# Created automatically on first test run. The name must end in "_test":
# the suite refuses to run destructive setup against anything else.
POSTGRES_TEST_DB=restaurant_intelligence_test

# --- Host port mappings ------------------------------------------------------
# Change these if something already listens on the port on your machine.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# --- Natural-language analytics (M7) -----------------------------------------
# OPTIONAL. Without a key the API starts normally and every other endpoint
# works; only POST /analytics/ask reports itself unavailable.
#
# Get a key from https://console.anthropic.com/. Put the real value in .env,
# which is gitignored — never in this file and never in code.
ANTHROPIC_API_KEY=

# Model used for planning and answering. Both stages use the same model.
LLM_MODEL=claude-opus-5

# Seconds before a single provider call is abandoned.
LLM_TIMEOUT_SECONDS=60

# Effort per stage. Planning is close to classification; explaining evidence
# faithfully is not.
LLM_PLANNER_EFFORT=low
LLM_ANSWER_EFFORT=medium

# Attempts at a schema-valid plan, including the first. The retry is shown the
# validation error. Set to 1 to disable the repair round.
LLM_MAX_PLAN_ATTEMPTS=2

# Which provider adapter to build. Only 'anthropic' exists today.
LLM_PROVIDER=anthropic

# Ask the provider to reroute a refused request to another model instead of
# returning a refusal. Set to false to send the plain request — useful if the
# fallback beta is ever withdrawn or renamed. A refusal is handled safely
# either way, so this only affects availability, never correctness.
LLM_REFUSAL_FALLBACKS=true
