# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file documents the
# SHAPE of the configuration; the real values stay on your machine.
# Compose reads .env automatically and substitutes these into
# docker-compose.yml.

# --- PostgreSQL --------------------------------------------------------------
# Read only on the database's FIRST boot, when the data directory is empty.
# Changing them later has no effect until the volume is removed
# (`docker compose down -v`), because the database already exists.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=restaurant_intelligence

# The database pytest uses, and the only one it is allowed to touch.
# Created automatically on first test run. The name must end in "_test":
# the suite refuses to run destructive setup against anything else.
POSTGRES_TEST_DB=restaurant_intelligence_test

# --- Host port mappings ------------------------------------------------------
# Change these if something already listens on the port on your machine.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
